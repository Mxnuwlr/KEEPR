{
  "name": "keepr",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "xcodebuild -workspace ios/keepr.xcworkspace -scheme keepr -configuration Debug -destination 'id=00008101-000968213881401E' -allowProvisioningUpdates -allowProvisioningDeviceRegistration build && expo run:ios --device 00008101-000968213881401E",
    "ios:fixsign": "xcodebuild -workspace ios/keepr.xcworkspace -scheme keepr -configuration Debug -destination 'id=00008101-000968213881401E' -allowProvisioningUpdates -allowProvisioningDeviceRegistration build",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "expo": "~55.0.8",
    "expo-camera": "~55.0.11",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "~55.0.12",
    "expo-font": "~55.0.4",
    "expo-image-picker": "~55.0.14",
    "expo-linear-gradient": "~55.0.14",
    "expo-notifications": "~55.0.23",
    "expo-secure-store": "~55.0.14",
    "expo-sensors": "~55.0.15",
    "expo-share-intent": "^6.1.1",
    "expo-status-bar": "~55.0.4",
    "expo-updates": "~55.0.24",
    "expo-video": "~55.0.17",
    "playwright": "^1.60.0",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "15.15.3",
    "react-native-webview": "13.16.0",
    "zustand": "^4.5.4"
